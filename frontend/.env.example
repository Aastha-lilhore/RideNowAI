# Copy this file to .env and fill in once the backend exists.
# With no .env file, the app defaults to mocks (VITE_USE_MOCKS=true).

# Base URL of the backend API (see docs/API_CONTRACT.md for endpoints).
VITE_API_BASE_URL=http://localhost:4000

# Set to false to call the real backend instead of the mock services.
VITE_USE_MOCKS=true
